#!/bin/sh

#######################################
#  _                                  #
# | |__  ___ _ ____      ___ __ ___   #
# | '_ \/ __| '_ \ \ /\ / / '_ ` _ \  #
# | |_) \__ \ |_) \ V  V /| | | | | | #
# |_.__/|___/ .__/ \_/\_/ |_| |_| |_| #
#           |_|                       #
#######################################

MONITOR="DP-2"

# Kill already running processes
killall -q sxhkd

# --set TearFree on prop not available
# See xrandr --prop
xrandr --output "$MONITOR" --mode 1920x1080 --rate 144
bspc monitor "$MONITOR" -d I II III IV V
# xrandr --output HDMI-1 --mode 3840x2160 --rate 120
# bspc monitor HDMI-1 -d I II III IV V

# Window config
# bspc config focus_follows_pointer true
bspc config border_width         2
bspc config window_gap           10

# Layout config
# bspc config automatic_scheme automatic
bspc config split_ratio          0.55
bspc config borderless_monocle   true
bspc config gapless_monocle      true

# Colorscheme
bspc config focused_border_color   "#5e81ac"
bspc config normal_border_color    "#3b4252"
bspc config presel_feedback_color  "#3b4252"

# Other
# bspc config remove_disabled_monitors  true
# bspc config remove_unplugged_monitors true

# Rules
bspc rule -a Chromium desktop="^2"
bspc rule -a Signal desktop="^3"
bspc rule -a KeePassXC state=floating
bspc rule -a Zathura state=tiled

# Startups
sxhkd &
feh --no-fehbg --bg-fill "$HOME"/Pictures/Wallpaper/Nord/wp.jpg
"$HOME"/.config/polybar/launch.sh
